# Packaging-only APKBUILD for pre-built binary (used by `just apk-build`)
pkgname=cosmic-ext-camera
pkgver=@@VERSION@@
pkgrel=0
pkgdesc="Modern camera app for Linux desktops and phones"
url="https://github.com/cosmic-utils/cosmic-ext-camera"
arch="all"
license="GPL-3.0-only"
depends="
	cosmic-icons
	gst-libav
	gst-plugins-bad
	gst-plugins-base
	gst-plugins-good
	libdav1d
"

build() { :; }

package() {
	cd /src
	just rootdir="$pkgdir" bin-src=/prebuilt/camera install
}
